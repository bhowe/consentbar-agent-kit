{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consent Bar Agent Kit Configuration",
  "type": "object",
  "required": [
    "version",
    "policyVersion",
    "policyUrl",
    "categories",
    "defaultConsent",
    "storage"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration schema version string."
    },
    "policyVersion": {
      "type": "string",
      "description": "Your privacy policy / consent policy revision id."
    },
    "policyUrl": {
      "type": "string",
      "format": "uri-reference",
      "description": "Policy URL shown in UI and audit expectations."
    },
    "categories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "essential",
          "statistics",
          "marketing",
          "preferences"
        ]
      },
      "uniqueItems": true
    },
    "defaultConsent": {
      "type": "object",
      "required": ["essential", "statistics", "marketing", "preferences"],
      "additionalProperties": false,
      "properties": {
        "essential": {
          "const": true
        },
        "statistics": {
          "type": "boolean"
        },
        "marketing": {
          "type": "boolean"
        },
        "preferences": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["key", "version", "expiryDays"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "expiryDays": {
          "type": "number",
          "minimum": 1,
          "maximum": 3650
        }
      }
    },
    "trackerPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "manageButtonLabel": {
          "type": "string"
        },
        "injectManageButton": {
          "type": "boolean"
        }
      }
    }
  }
}
